<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/obd_card_bg"
    android:minHeight="72dp"
    android:orientation="vertical"
    android:padding="10dp">

    <ImageView
        android:id="@+id/cardIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_star_circle"
        app:tint="#e02020" />

    <TextView
        android:id="@+id/cardLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:letterSpacing="0.08"
        android:text="DTC CODE"
        android:textAllCaps="true"
        android:textColor="#8fb4cb"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/cardValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="P0301"
        android:textColor="#e3f5ff"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/cardUnit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:letterSpacing="0.04"
        android:maxLines="2"
        android:text="Cylinder 1 Misfire"
        android:textColor="#6e95ad"
        android:textSize="9sp" />

</LinearLayout>

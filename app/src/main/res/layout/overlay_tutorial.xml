<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlayTutorial"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B3000000"
    android:clickable="true"
    android:focusable="true"
    android:elevation="24dp"
    android:visibility="gone">

    <!-- Spotlight Frame Target -->
    <View
        android:id="@+id/viewSpotlight"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_glass_panel"
        android:backgroundTint="#1AFF4D4D"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Dialogue Card (Positioned Dynamically via ConstraintLayout Bias) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTutorialDialogue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="32dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="20dp"
        app:cardElevation="16dp"
        app:strokeColor="@color/theme_red"
        app:strokeWidth="1.5dp"
        app:layout_constraintBottom_toTopOf="@id/tvTapHint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.8">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTutorialStepTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Step 1 of 8: Active Vehicle Profile"
                    android:textColor="@color/theme_red"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSkipTutorial"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Skip"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginVertical="10dp" />

            <TextView
                android:id="@+id/tvTutorialDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Displays your active vehicle (e.g. Toyota Vios 1.3L). Tap here anytime to switch vehicle profiles or specs!"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:lineSpacingExtra="5dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Tap Screen To Continue Prompt -->
    <TextView
        android:id="@+id/tvTapHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:text="Tap anywhere on the screen to continue ▶"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="@drawable/bg_chip_red_light"
        android:backgroundTint="#40000000"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

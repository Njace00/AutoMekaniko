<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="8dp"
    android:paddingHorizontal="6dp"
    android:clickable="true"
    android:focusable="true"
    android:background="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/stepCheckboxIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null"
            android:src="@drawable/checkbox_red_unchecked"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/stepLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="start"
            android:textAlignment="viewStart"
            android:textColor="@color/text_primary"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnStepInfo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="2dp"
            android:src="@drawable/ic_expand_more"
            android:visibility="gone"
            android:contentDescription="@null"
            app:tint="@color/text_primary" />

    </LinearLayout>

    <TextView
        android:id="@+id/stepInfoText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="38dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/text_primary"
        android:textSize="13.5sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/stepWarningText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="38dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/info_tab_bg"
        android:backgroundTint="@color/theme_red_light"
        android:padding="8dp"
        android:textColor="@color/theme_red"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>

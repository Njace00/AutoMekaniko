<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glassmorphic_background">

    <!-- TOP BAR -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/background_secondary"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/appTitle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:text="AutoMekaniko"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <!-- "Auto" in white, "Mekaniko" in red — set via SpannableString in Kotlin -->
        </TextView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- SCROLLABLE CARDS WITH FILL VIEWPORT -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="14dp">

            <!-- ── CARD 1: DTC CODES (STRETCHED VERTICALLY) ─────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDtc"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/glass_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:strokeColor="@color/glass_border"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Clickable Red Header Action Bar -->
                    <LinearLayout
                        android:id="@+id/headerDtc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_chip_red_light"
                        android:padding="8dp"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <!-- Icon box -->
                        <ImageView
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:padding="10dp"
                            android:src="@drawable/ic_sensors"
                            android:contentDescription="@null"
                            app:tint="@android:color/white"
                            android:background="@color/theme_red"
                            android:layout_marginEnd="12dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DTC Codes"
                                android:textColor="@color/theme_red"
                                android:textSize="19sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Step-by-Step Repair to Fix DTC Error Codes"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="@color/theme_red"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:paddingStart="8dp"/>

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"/>

                    <!-- Overview Button (Moved Upward) -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/btnDtcOverview"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="📋 Trouble Codes Overview ▾"
                        android:textColor="@color/theme_red"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:chipBackgroundColor="@color/theme_red_light"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/theme_red" />

                    <!-- Peek Preview Row ("Information Leaking" Visual Indicator) -->
                    <LinearLayout
                        android:id="@+id/containerDtcPeek"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="P0301"
                            android:textColor="@color/theme_red"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_chip_red_light"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="P2118"
                            android:textColor="@color/theme_red"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_chip_neutral"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="P0100"
                            android:textColor="@color/theme_red"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_chip_neutral"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+More ▾"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Inline Expandable Container with Fixed Scrollable Height -->
                    <androidx.core.widget.NestedScrollView
                        android:id="@+id/expandableDtcSection"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:layout_marginTop="10dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ACTIVE TROUBLE CODES BREAKDOWN"
                                android:textColor="@color/theme_red"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08"
                                android:layout_marginBottom="8dp"/>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginBottom="8dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="P0301 — Cylinder 1 Misfire Detected"
                                    android:textColor="@color/text_primary"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Inspect ignition coil #1, spark plug condition &amp; gap, and fuel injector circuit."
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13sp"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginBottom="8dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="P2118 — Throttle Control Motor Power"
                                    android:textColor="@color/text_primary"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Inspect 10A ETCS fuse in engine bay fuse box and check throttle actuator connector."
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13sp"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginBottom="12dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="P0100 — Mass Air Flow Sensor Circuit"
                                    android:textColor="@color/text_primary"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Check MAF sensor harness, clean sensing wire, and inspect air filter box."
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13sp"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="INCLUDED REPAIR FEATURES"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08"
                                android:layout_marginBottom="8dp"/>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="3D Model"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/theme_red"
                                    android:background="@drawable/bg_chip_red_light"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="5dp"
                                    android:layout_marginEnd="8dp"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Root Cause Analysis"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary"
                                    android:background="@drawable/bg_chip_neutral"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="5dp"
                                    android:layout_marginEnd="8dp"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Step-by-Step Fix"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary"
                                    android:background="@drawable/bg_chip_neutral"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="5dp"/>

                            </LinearLayout>

                        </LinearLayout>
                    </androidx.core.widget.NestedScrollView>

                    <!-- Bottom Spacer pushing summary to the very bottom -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- Summary Badge Footnote (Pushed to bottom) -->
                    <TextView
                        android:id="@+id/tvDtcSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="3 Interactive Diagnostic Repair Guides Available • Tap to open"
                        android:textColor="@color/theme_red"
                        android:textSize="12sp"
                        android:textStyle="italic"
                        android:layout_marginTop="12dp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── CARD 2: MAINTENANCE (STRETCHED VERTICALLY) ──────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMaintenance"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/glass_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:strokeColor="@color/glass_border"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Clickable Red Header Action Bar -->
                    <LinearLayout
                        android:id="@+id/headerMaint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_chip_red_light"
                        android:padding="8dp"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <!-- Icon box -->
                        <ImageView
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:padding="10dp"
                            android:src="@drawable/ic_settings"
                            android:contentDescription="@null"
                            app:tint="@android:color/white"
                            android:background="@color/theme_red"
                            android:layout_marginEnd="12dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Maintenance"
                                android:textColor="@color/theme_red"
                                android:textSize="19sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Step-by-Step Repair Guides &amp; Checklist"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="@color/theme_red"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:paddingStart="8dp"/>

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"/>

                    <!-- Overview Button (Moved Upward) -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/btnMaintOverview"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="🧰 Toolkit &amp; Procedures ▾"
                        android:textColor="@color/theme_red"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:chipBackgroundColor="@color/theme_red_light"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/theme_red" />

                    <!-- Peek Preview Row ("Information Leaking" Visual Indicator) -->
                    <LinearLayout
                        android:id="@+id/containerMaintPeek"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Oil &amp; Filter"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:background="@drawable/bg_chip_neutral"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Air Filter"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:background="@drawable/bg_chip_neutral"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Battery"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:background="@drawable/bg_chip_neutral"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+More ▾"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Inline Expandable Container with Fixed Scrollable Height -->
                    <androidx.core.widget.NestedScrollView
                        android:id="@+id/expandableMaintSection"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:layout_marginTop="10dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="GUIDED MAINTENANCE PROCEDURES"
                                android:textColor="@color/theme_red"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08"
                                android:layout_marginBottom="8dp"/>

                            <!-- Proc 1 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginBottom="8dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Engine Oil &amp; Filter Change"
                                    android:textColor="@color/text_primary"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Inspect dipstick level, viscosity color, drain plug gasket &amp; filter torque."
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13sp"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <!-- Proc 2 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginBottom="8dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Air Intake Filter Inspection"
                                    android:textColor="@color/text_primary"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Check filter element cleanliness, housing clips, and intake duct sealing."
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13sp"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <!-- Proc 3 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginBottom="12dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="12V Battery &amp; Terminal Maintenance"
                                    android:textColor="@color/text_primary"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Test 12.4V-12.7V rest voltage, clean terminal corrosion &amp; inspect tray mount."
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13sp"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="REQUIRED TOOLKIT &amp; SUPPLIES"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08"
                                android:layout_marginBottom="8dp"/>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Wrench Set"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/theme_red"
                                    android:background="@drawable/bg_chip_red_light"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="5dp"
                                    android:layout_marginEnd="8dp"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Jack Stand"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/theme_red"
                                    android:background="@drawable/bg_chip_red_light"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="5dp"
                                    android:layout_marginEnd="8dp"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Screwdriver"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/theme_red"
                                    android:background="@drawable/bg_chip_red_light"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="5dp"
                                    android:layout_marginEnd="8dp"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Gloves"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/theme_red"
                                    android:background="@drawable/bg_chip_red_light"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="5dp"/>

                            </LinearLayout>

                        </LinearLayout>
                    </androidx.core.widget.NestedScrollView>

                    <!-- Bottom Spacer pushing summary to the very bottom -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- Summary Footnote (Pushed to bottom) -->
                    <TextView
                        android:id="@+id/tvMaintSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="5 Preventive Maintenance Guides with Tool Lists &amp; Checklists • Tap to open"
                        android:textColor="@color/theme_red"
                        android:textSize="12sp"
                        android:textStyle="italic"
                        android:layout_marginTop="12dp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM BAR -->
    <include
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- INTERACTIVE ONBOARDING TUTORIAL OVERLAY -->
    <include
        layout="@layout/overlay_tutorial"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

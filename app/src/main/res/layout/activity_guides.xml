<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <!-- TOP BAR -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/background_secondary"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/appTitle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:text="AutoMekaniko"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <!-- "Auto" in white, "Mekaniko" in red — set via SpannableString in Kotlin -->
        </TextView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- SCROLLABLE CARDS WITH FILL VIEWPORT -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="14dp">

            <!-- ── CARD 1: DTC CODES (STRETCHED VERTICALLY) ─────────────── -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardDtc"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="14dp"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Header row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Icon box -->
                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:padding="12dp"
                            android:src="@drawable/ic_sensors"
                            android:contentDescription="DTC Sensors Icon"
                            app:tint="@color/theme_red"
                            android:background="@drawable/bg_chip_red_light"
                            android:layout_marginEnd="14dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DTC Codes"
                                android:textColor="@color/text_primary"
                                android:textSize="19sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Step-by-Step Repair to Fix DTC Error Codes"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:layout_marginTop="3dp"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="@color/theme_red"
                            android:textSize="28sp"
                            android:paddingStart="8dp"/>

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"/>

                    <!-- Top Spacer pushing middle content block downwards -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- Section Title: Trouble Codes -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACTIVE &amp; COMMON TROUBLE CODES"
                        android:textColor="@color/theme_red"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="10dp"/>

                    <!-- DTC Code Badges Container -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:overScrollMode="never"
                        android:layout_marginBottom="14dp">

                        <LinearLayout
                            android:id="@+id/containerDtcCodes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Code Item 1 -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:background="@drawable/bg_chip_red_light"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="10dp"
                                android:layout_marginEnd="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="P0301"
                                    android:textColor="@color/theme_red"
                                    android:textSize="14sp"
                                    android:textStyle="bold"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Cylinder 1 Misfire"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12sp"
                                    android:layout_marginTop="3dp"/>
                            </LinearLayout>

                            <!-- Code Item 2 -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:background="@drawable/bg_chip_neutral"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="10dp"
                                android:layout_marginEnd="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="P2118"
                                    android:textColor="@color/theme_red"
                                    android:textSize="14sp"
                                    android:textStyle="bold"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Throttle Control"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12sp"
                                    android:layout_marginTop="3dp"/>
                            </LinearLayout>

                            <!-- Code Item 3 -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:background="@drawable/bg_chip_neutral"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="P0100"
                                    android:textColor="@color/theme_red"
                                    android:textSize="14sp"
                                    android:textStyle="bold"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="MAF Sensor Circuit"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12sp"
                                    android:layout_marginTop="3dp"/>
                            </LinearLayout>

                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Feature Tags Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3D Model"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:background="@drawable/bg_chip_neutral"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Root Cause"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:background="@drawable/bg_chip_neutral"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Step-by-Step Fix"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:background="@drawable/bg_chip_neutral"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"/>

                    </LinearLayout>

                    <!-- Bottom Spacer pushing summary to the very bottom -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- Summary Badge Footnote (Pushed to bottom) -->
                    <TextView
                        android:id="@+id/tvDtcSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="3 Interactive Diagnostic Repair Guides Available • Tap to open"
                        android:textColor="@color/theme_red"
                        android:textSize="12sp"
                        android:textStyle="italic"
                        android:layout_marginTop="12dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ── CARD 2: MAINTENANCE (STRETCHED VERTICALLY) ──────────── -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardMaintenance"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Header row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Icon box -->
                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:padding="12dp"
                            android:src="@drawable/ic_settings"
                            android:contentDescription="Maintenance Settings Icon"
                            app:tint="@color/theme_red"
                            android:background="@drawable/bg_chip_red_light"
                            android:layout_marginEnd="14dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Maintenance"
                                android:textColor="@color/text_primary"
                                android:textSize="19sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Step-by-Step Repair Guides &amp; Checklist"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:layout_marginTop="3dp"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="@color/theme_red"
                            android:textSize="28sp"
                            android:paddingStart="8dp"/>

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"/>

                    <!-- Top Spacer pushing middle content block downwards -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- Section Title: Maintenance Procedures -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GUIDED CARE &amp; MAINTENANCE PROCEDURES"
                        android:textColor="@color/theme_red"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="10dp"/>

                    <!-- Maintenance Procedure Chips Container -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:overScrollMode="never"
                        android:layout_marginBottom="14dp">

                        <LinearLayout
                            android:id="@+id/containerMaintGuides"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Oil &amp; Filter"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:background="@drawable/bg_chip_neutral"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="8dp"
                                android:layout_marginEnd="8dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Air Filter"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:background="@drawable/bg_chip_neutral"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="8dp"
                                android:layout_marginEnd="8dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Battery Replace"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:background="@drawable/bg_chip_neutral"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="8dp"
                                android:layout_marginEnd="8dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Care Checklist"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:background="@drawable/bg_chip_neutral"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="8dp"/>

                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Section Title: Required Toolkit Preview -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PREPARE YOUR TOOLKIT"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="8dp"/>

                    <!-- Tool Kit Badges Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wrench Set"
                            android:textSize="12sp"
                            android:textColor="@color/theme_red"
                            android:background="@drawable/bg_chip_red_light"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Jack Stand"
                            android:textSize="12sp"
                            android:textColor="@color/theme_red"
                            android:background="@drawable/bg_chip_red_light"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Screwdriver"
                            android:textSize="12sp"
                            android:textColor="@color/theme_red"
                            android:background="@drawable/bg_chip_red_light"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gloves"
                            android:textSize="12sp"
                            android:textColor="@color/theme_red"
                            android:background="@drawable/bg_chip_red_light"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"/>

                    </LinearLayout>

                    <!-- Bottom Spacer pushing summary to the very bottom -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- Summary Footnote (Pushed to bottom) -->
                    <TextView
                        android:id="@+id/tvMaintSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="5 Preventive Maintenance Guides with Tool Lists &amp; Checklists • Tap to open"
                        android:textColor="@color/theme_red"
                        android:textSize="12sp"
                        android:textStyle="italic"
                        android:layout_marginTop="12dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM BAR -->
    <include
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

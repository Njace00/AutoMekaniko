<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/obd_sensor_card.xml
     A single reusable sensor tile for the OBD-II grid.
     The host Activity sets label, value, and unit via view-binding on the included ID. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/obd_card_bg"
    android:gravity="center_horizontal"
    android:minHeight="120dp">

    <TextView
        android:id="@+id/cardLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LABEL"
        android:textColor="@color/app_text_secondary"
        android:textSize="9sp"
        android:letterSpacing="0.08"
        android:textAllCaps="true"
        android:layout_marginBottom="4dp"/>

    <com.example.automekaniko.ModernArcGauge
        android:id="@+id/gauge"
        android:layout_width="match_parent"
        android:layout_height="120dp" />

    <!-- Fallback/Legacy text views (initially gone or small) -->
    <TextView
        android:id="@+id/cardValue"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/cardUnit"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"/>

</LinearLayout>
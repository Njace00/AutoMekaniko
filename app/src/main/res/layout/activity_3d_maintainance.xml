<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/app_surface"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/appTitle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="AutoMekaniko"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0">
            <!-- "Auto" in white, "Mekaniko" in red — set via SpannableString in Kotlin -->
        </TextView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_background"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/abc_ic_ab_back_material"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/theme_red" />

        <ImageView
            android:id="@+id/btnDebugCamera"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_settings"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/backBtn"
            app:layout_constraintBottom_toBottomOf="@id/backBtn"
            app:tint="@color/theme_red" />

        <TextView
            android:id="@+id/tvMaintainanceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Maintainance"
            android:textColor="@color/app_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/backBtn"
            app:layout_constraintStart_toEndOf="@id/backBtn"
            app:layout_constraintTop_toTopOf="@id/backBtn" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/modelDropdownLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            app:boxStrokeColor="@color/theme_red"
            app:hintTextColor="@color/theme_red"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvMaintainanceTitle"
            app:layout_constraintBottom_toBottomOf="parent">

            <AutoCompleteTextView
                android:id="@+id/modelAutoComplete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:padding="12dp"
                android:textColor="@color/app_text_primary"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/card_left_border_thick"
        app:layout_constraintBottom_toTopOf="@id/progressSection"
        app:layout_constraintTop_toBottomOf="@id/headerSection">

        <io.github.sceneview.SceneView
            android:id="@+id/sceneView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/lockOverlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="@id/sceneView"
            app:layout_constraintEnd_toEndOf="@id/sceneView"
            app:layout_constraintStart_toStartOf="@id/sceneView"
            app:layout_constraintTop_toTopOf="@id/sceneView" />

        <TextView
            android:id="@+id/modelTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Types of Oil &amp; Recommended"
            android:textColor="#222222"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/closeTab"
            android:layout_width="24dp"
            android:layout_height="84dp"
            android:background="@drawable/close_tab_bg"
            android:clickable="true"
            android:elevation="14dp"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivTabArrowTop"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_left"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvTabText"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:rotation="270"
                android:singleLine="true"
                android:text="INFO"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivTabArrowBottom"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_left"
                app:tint="#FFFFFF" />

        </LinearLayout>

        <ScrollView
            android:id="@+id/infoSlidePanel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/app_background"
            android:elevation="2dp"
            android:padding="16dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvInfoPanelTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="Types of Oil &amp; Recommended"
                    android:textColor="@color/app_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/infoItemsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </FrameLayout>
            </LinearLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/progressSection"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp"
        android:background="@color/app_surface"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toTopOf="@id/navButtonsSection">

        <ImageView
            android:id="@+id/ivProgressIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_star_circle"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/theme_red" />

        <ImageView
            android:id="@+id/bottomDrawerArrow"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="5dp"
            android:src="@drawable/ic_expand_less"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/ivProgressIcon"
            app:tint="@color/theme_red" />

        <TextView
            android:id="@+id/slideTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Lights"
            android:textColor="@color/app_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/bottomDrawerArrow"
            app:layout_constraintStart_toEndOf="@id/ivProgressIcon"
            app:layout_constraintTop_toTopOf="@id/ivProgressIcon" />

        <TextView
            android:id="@+id/slideDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Check every light both front and back (1/4 Done)"
            android:textColor="@color/app_text_secondary"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/slideTitle"
            app:layout_constraintTop_toBottomOf="@id/slideTitle" />

        <ScrollView
            android:id="@+id/bottomChecklistScroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/slideTitle"
            app:layout_constraintTop_toBottomOf="@id/slideDesc">

            <LinearLayout
                android:id="@+id/checklistContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/debugPanel"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="24dp"
        app:cardBackgroundColor="#F0FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerSection">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Camera Debug"
                    android:textStyle="bold"
                    android:textColor="#e02020"
                    android:textSize="16sp" />
                <ImageView
                    android:id="@+id/btnCloseDebug"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#e02020" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EYE POSITION"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#888888"
                android:layout_marginTop="8dp"/>
            <TextView
                android:id="@+id/tvDebugEyeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#222222"
                android:fontFamily="monospace"
                android:text="Vec3(0.00f, 0.00f, 0.00f)"/>
            <SeekBar android:id="@+id/sbEyeX" android:layout_width="match_parent" android:layout_height="32dp" android:max="1000" android:progress="500"/>
            <SeekBar android:id="@+id/sbEyeY" android:layout_width="match_parent" android:layout_height="32dp" android:max="1000" android:progress="500"/>
            <SeekBar android:id="@+id/sbEyeZ" android:layout_width="match_parent" android:layout_height="32dp" android:max="1000" android:progress="500"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOOK-AT TARGET"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#888888"
                android:layout_marginTop="8dp"/>
            <TextView
                android:id="@+id/tvDebugLookAtValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#222222"
                android:fontFamily="monospace"
                android:text="Vec3(0.00f, 0.00f, 0.00f)"/>
            <SeekBar android:id="@+id/sbLookAtX" android:layout_width="match_parent" android:layout_height="32dp" android:max="1000" android:progress="500"/>
            <SeekBar android:id="@+id/sbLookAtY" android:layout_width="match_parent" android:layout_height="32dp" android:max="1000" android:progress="500"/>
            <SeekBar android:id="@+id/sbLookAtZ" android:layout_width="match_parent" android:layout_height="32dp" android:max="1000" android:progress="500"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/navButtonsSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnPrev"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="#e0e0e0"
            android:text="Prev"
            android:textAllCaps="false"
            android:textColor="#333333"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="2"
            android:backgroundTint="@color/theme_red"
            android:text="Next"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
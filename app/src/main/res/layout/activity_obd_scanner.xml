<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <!-- TOP BAR -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/background_secondary"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/appTitle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:text="AutoMekaniko"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0">
            <!-- "Auto" in white, "Mekaniko" in red — set via SpannableString in Kotlin -->
        </TextView>

        <!-- ── TAB BUTTONS ── -->
        <LinearLayout
            android:id="@+id/tabGroup"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="12dp"
            android:orientation="horizontal"
            android:clipChildren="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- SCROLLABLE OBD-II DATA AREA -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/connectRow">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:clipToPadding="false">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <View android:layout_width="4dp" android:layout_height="12dp" android:background="@color/theme_red"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CORE ENGINE DATA" android:textColor="@color/text_primary" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.1" android:layout_marginStart="8dp"/>
            </LinearLayout>

            <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:rowCount="3" android:useDefaultMargins="false" android:layout_marginBottom="12dp">
                <include android:id="@+id/cardRpm"      layout="@layout/obd_sensor_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp"/>
                <include android:id="@+id/cardSpeed"    layout="@layout/obd_sensor_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp"/>
                <include android:id="@+id/cardCoolant"  layout="@layout/obd_sensor_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp"/>
                <include android:id="@+id/cardThrottle" layout="@layout/obd_sensor_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp"/>
                <include android:id="@+id/cardLoad"     layout="@layout/obd_sensor_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp"/>
            </GridLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="8dp">
                <View android:layout_width="4dp" android:layout_height="12dp" android:background="@color/theme_red"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LIVE OBD-II SENSORS" android:textColor="@color/text_primary" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.1" android:layout_marginStart="8dp"/>
            </LinearLayout>

            <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:rowCount="3" android:useDefaultMargins="false" android:layout_marginBottom="12dp">
                <include android:id="@+id/cardMaf"       layout="@layout/obd_sensor_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp"/>
                <include android:id="@+id/cardIat"       layout="@layout/obd_sensor_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp"/>
                <include android:id="@+id/cardO2s1"      layout="@layout/obd_sensor_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp"/>
                <include android:id="@+id/cardO2s2"      layout="@layout/obd_sensor_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp"/>
                <include android:id="@+id/cardMap"       layout="@layout/obd_sensor_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp"/>
                <include android:id="@+id/cardFuelLevel" layout="@layout/obd_sensor_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp"/>
            </GridLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="8dp">
                <View android:layout_width="4dp" android:layout_height="12dp" android:background="@color/theme_red"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FUEL TRIM &amp; TIMING" android:textColor="@color/text_primary" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.1" android:layout_marginStart="8dp"/>
            </LinearLayout>

            <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:rowCount="2" android:useDefaultMargins="false" android:layout_marginBottom="12dp">
                <include android:id="@+id/cardStft"   layout="@layout/obd_sensor_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp"/>
                <include android:id="@+id/cardLtft"   layout="@layout/obd_sensor_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp"/>
                <include android:id="@+id/cardTiming" layout="@layout/obd_sensor_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp"/>
                <include android:id="@+id/cardBaro"   layout="@layout/obd_sensor_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp"/>
            </GridLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="8dp">
                <View android:layout_width="4dp" android:layout_height="12dp" android:background="@color/theme_red"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CATALYST &amp; ELECTRICAL" android:textColor="@color/text_primary" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.1" android:layout_marginStart="8dp"/>
            </LinearLayout>

            <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:rowCount="2" android:useDefaultMargins="false" android:layout_marginBottom="12dp">
                <include android:id="@+id/cardCat1"       layout="@layout/obd_sensor_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp"/>
                <include android:id="@+id/cardCat2"       layout="@layout/obd_sensor_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp"/>
                <include android:id="@+id/cardModVoltage" layout="@layout/obd_sensor_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp"/>
                <include android:id="@+id/cardFuelRate"   layout="@layout/obd_sensor_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp"/>
            </GridLayout>

        </LinearLayout>
    </ScrollView>

    <!-- CONNECT ROW -->
    <LinearLayout
        android:id="@+id/connectRow"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:background="@color/background_secondary"
        android:elevation="4dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar">


        <TextView
            android:id="@+id/tvBleStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● DISCONNECTED"
            android:textColor="@color/theme_red"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingEnd="10dp" />


        <TextView
            android:id="@+id/tvStatusMsg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="Tap Connect to scan for ELM327 adapter"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingEnd="12dp"/>

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:text="CONNECT"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="@color/theme_red"
            android:stateListAnimator="@null"/>

    </LinearLayout>

    <!-- BOTTOM BAR -->
    <include
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
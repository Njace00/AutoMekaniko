<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <!-- TOP BAR -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/background_secondary"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/appTitle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:text="AutoMekaniko"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- HEADER SECTION -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_primary"
        android:paddingBottom="6dp"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_back_red"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvDtcTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="DTC Guides"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/backBtn"
            app:layout_constraintStart_toEndOf="@id/backBtn"
            app:layout_constraintTop_toTopOf="@id/backBtn" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHeaderVehicle"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp"
            android:paddingHorizontal="8dp"
            android:text="🚘 Vios 1.3L"
            android:textColor="@color/theme_red"
            android:textSize="14.5sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tvDtcTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvDtcTitle" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/menuDtc"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/theme_red"
            app:hintEnabled="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/backBtn">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/dtcAutoComplete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:paddingVertical="12dp"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                tools:ignore="LabelFor" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- GUIDE META BAR -->
        <LinearLayout
            android:id="@+id/guideMetaBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/menuDtc">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDifficulty"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Moderate"
                android:textColor="@color/theme_red"
                android:textSize="12sp"
                app:chipBackgroundColor="@color/theme_red_light"
                app:chipStrokeWidth="0dp" />

            <TextView
                android:id="@+id/tvEstTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="⏱ 35 mins"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToolsPrep"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:paddingHorizontal="8dp"
                android:text="🧰 Tools &amp; Prep"
                android:textColor="@color/theme_red"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/stepProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/gauge_progress_drawable"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/guideMetaBar" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- FULL 3D CONTAINER (EXPANDED TO BOTTOM) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mainCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/divider"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerSection">

        <io.github.sceneview.SceneView
            android:id="@+id/sceneView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/lockOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:visibility="visible" />

        <!-- FLOATING 3D HUD PART BADGE (Top-Start) -->
        <LinearLayout
            android:id="@+id/hudPartBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:background="@drawable/bg_glass_panel"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:elevation="4dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvHudPartName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Spark Plug #1"
                android:textColor="@color/theme_red"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CIRCULAR INFO BUTTON (Top-End) -->
        <ImageButton
            android:id="@+id/btnInfoModern"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_info_button"
            android:elevation="4dp"
            android:src="@drawable/ic_info_modern"
            app:tint="@color/theme_red" />

        <!-- CIRCULAR OVERVIEW / CHECKLIST BUTTON (Directly Below Info Button) -->
        <ImageButton
            android:id="@+id/btnOverviewModern"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="68dp"
            android:background="@drawable/bg_info_button"
            android:elevation="4dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_checklist"
            app:tint="@color/theme_red" />

        <!-- FLOATING PREV / NEXT NAVIGATION BUTTONS (INSIDE 3D CONTAINER AT BOTTOM) -->
        <LinearLayout
            android:id="@+id/navButtonsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="12dp"
            android:animateLayoutChanges="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrev"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="90dp"
                android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:text="Prev"
                android:textAllCaps="false"
                android:visibility="gone"
                app:cornerRadius="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Next Step"
                android:textColor="@android:color/white"
                android:textAllCaps="false"
                android:textStyle="bold"
                app:cornerRadius="24dp"
                app:backgroundTint="@color/theme_red" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- GLASS INFO PANEL (Constrained INSIDE mainCard) -->
    <ScrollView
        android:id="@+id/infoSlidePanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_glass_panel"
        android:elevation="12dp"
        android:padding="20dp"
        android:visibility="gone"
        android:layout_margin="20dp"
        app:layout_constraintBottom_toBottomOf="@id/mainCard"
        app:layout_constraintEnd_toEndOf="@id/mainCard"
        app:layout_constraintStart_toStartOf="@id/mainCard"
        app:layout_constraintTop_toTopOf="@id/mainCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvInfoPanelTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="Recommended Info"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/infoItemsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btnCloseInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Got it"
                android:layout_marginTop="16dp"
                style="@style/Widget.Material3.Button.TextButton"
                android:textColor="@color/theme_red" />

        </LinearLayout>
    </ScrollView>

    <!-- GLASS OVERVIEW & CHECKLIST PANEL (Constrained INSIDE mainCard) -->
    <ScrollView
        android:id="@+id/checklistSlidePanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_glass_panel"
        android:elevation="12dp"
        android:padding="20dp"
        android:visibility="gone"
        android:layout_margin="20dp"
        app:layout_constraintBottom_toBottomOf="@id/mainCard"
        app:layout_constraintEnd_toEndOf="@id/mainCard"
        app:layout_constraintStart_toStartOf="@id/mainCard"
        app:layout_constraintTop_toTopOf="@id/mainCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/slideTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Overview"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/slideDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step Description"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:id="@+id/checklistContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btnCloseChecklist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Got it"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                style="@style/Widget.Material3.Button.TextButton"
                android:textColor="@color/theme_red" />

        </LinearLayout>
    </ScrollView>

    <!-- HIDE UNUSED DUMMY CONTAINERS -->
    <View android:id="@+id/cardOverviewButton" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
    <View android:id="@+id/progressSection" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
    <View android:id="@+id/bottomChecklistScroll" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
    <View android:id="@+id/bottomDrawerArrow" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>

    <include
        android:id="@+id/bottomBar"
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
